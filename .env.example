# Optional. Override the default backend model route. The app posts
# { messages } to /api/ai by default, which invokes the Claude CLI server-side.
VITE_AI_ENDPOINT=

# Optional. Long-lived Claude Code token used by the headless refresh scripts
# (refresh.sh, refresh-all.sh) so a scheduled run does not depend on an
# interactive login. Mint one with `claude setup-token`.
# Copy this file to .env (untracked) and set the value there — never here.
SECOND_BRAIN_CLAUDE_TOKEN=
